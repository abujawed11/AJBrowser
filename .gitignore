## Visual Studio / .NET .gitignore

# Visual Studio cache/options
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# Rider
.idea/

# Build results
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rm/
[Aa]rm64/
[Ll]og/
[Ll]ogs/
artifacts/
publish/
*.pubxml
*.publishproj

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml

# WebView2 user data (created next to the exe by default)
*.WebView2/

# Misc
*.log
*.tmp
*.cache
*.pdb
*.ilk
*.obj
*.pch
*.vspscc
*.vssscc
_ReSharper*/
*.DotSettings.user
~$*
*~

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

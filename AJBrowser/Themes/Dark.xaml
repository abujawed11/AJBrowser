<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Must define exactly the same keys as Light.xaml. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#383838" />
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ToolbarButtonHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ToolbarButtonPressedBrush" Color="#454545" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="SwitchKnobOnBrush" Color="#000000" />
</ResourceDictionary>

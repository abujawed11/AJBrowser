<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Semantic brushes for AJBrowser's own chrome (tab strip, toolbar, panels).
        Dark.xaml must define exactly the same keys. Always reference them with DynamicResource
        so the theme can switch at runtime.
    -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#EBEBEB" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#D6D6D6" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F5F5F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AJBrowser.Core\AJBrowser.Core.csproj" />
  </ItemGroup>

  <!-- Phase 0.5 feasibility spike: the Diagnostics window exists only in Debug builds. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Diagnostics\**" />
    <Page Remove="Diagnostics\**" />
    <None Remove="Diagnostics\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Update="Diagnostics\TestPages\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

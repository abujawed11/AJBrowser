<Application x:Class="AJBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <!-- No StartupUri: App.OnStartup builds the services and shows the main window. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AJBrowser;component/Themes/Shared.xaml" />
                <!-- Swapped for Dark.xaml at runtime by ThemeService. Listed here so the XAML designer finds the brushes. -->
                <ResourceDictionary Source="/AJBrowser;component/Themes/Light.xaml" />
                <!-- Styles shared by the internal pages (History, Bookmarks, Settings). -->
                <ResourceDictionary Source="/AJBrowser;component/Themes/Pages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

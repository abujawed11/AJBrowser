<UserControl x:Class="AJBrowser.Views.Controls.VideoPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AJBrowser.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TabViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="380">
    <!--
        "Videos on this page" (Phase 5). DataContext: the selected TabViewModel; rows are its Media list.
        Whole video files and HLS/DASH streams have a Download button; streams also offer their qualities (and DASH its sound tracks).
    -->
    <StackPanel>
        <TextBlock Text="Videos on this page" FontSize="16" FontWeight="SemiBold" Margin="4,0,0,4" />
        <TextBlock Text="Found while the page loaded or played. Quality and size show when the site reveals them."
                   Margin="4,0,4,8" FontSize="{StaticResource CaptionFontSize}" Style="{StaticResource SecondaryTextStyle}" />

        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <!-- yt-dlp (Phase 7.5c): the page's video read by yt-dlp; on YouTube & co. it replaces the page's own finds. -->
            <!-- Hidden while there's no yt-dlp row: with null content WPF would still draw the template, bound to the tab
                 itself (empty title, empty lists, a false "Added to downloads"; your report). -->
            <ContentControl Content="{Binding YtDlpVideo}" Focusable="False" IsTabStop="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding YtDlpVideo}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:YtDlpVideoViewModel}">
                        <Border Padding="6" CornerRadius="4" ToolTip="{Binding PageUrl}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="&#xE792;" Style="{StaticResource RowIconButtonStyle}"
                                        Command="{Binding SaveAsCommand}" VerticalAlignment="Top" Margin="2,2,0,0"
                                        Visibility="{Binding CanDownload, Converter={StaticResource PageBoolToVisibility}}"
                                        ToolTip="Save as… (choose the folder and name)" AutomationProperties.Name="Save video as (yt-dlp)" />
                                <Button DockPanel.Dock="Right" Content="Download" Command="{Binding DownloadCommand}" MinWidth="88"
                                        VerticalAlignment="Top" Margin="8,2,0,0" Style="{DynamicResource AccentButtonStyle}"
                                        Visibility="{Binding CanDownload, Converter={StaticResource PageBoolToVisibility}}"
                                        AutomationProperties.Name="Download video (yt-dlp)" />
                                <TextBlock DockPanel.Dock="Left" Text="&#xE714;" FontFamily="{StaticResource IconFontFamily}" FontSize="20"
                                           VerticalAlignment="Top" Margin="0,2,10,0" Foreground="{DynamicResource AccentBrush}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Added to downloads" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource SuccessBrush}"
                                               Visibility="{Binding WasQueued, Converter={StaticResource PageBoolToVisibility}}" />
                                    <TextBlock Text="{Binding QualitySummary}" FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Label"
                                              Margin="0,4,0,0" FontSize="{StaticResource CaptionFontSize}"
                                              Visibility="{Binding HasQualities, Converter={StaticResource PageBoolToVisibility}}"
                                              AutomationProperties.Name="Quality (yt-dlp)" />
                                    <ComboBox ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudio}" DisplayMemberPath="Label"
                                              Margin="0,4,0,0" FontSize="{StaticResource CaptionFontSize}"
                                              Visibility="{Binding HasAudioChoices, Converter={StaticResource PageBoolToVisibility}}"
                                              AutomationProperties.Name="Sound track (yt-dlp)" />
                                    <TextBlock Text="{Binding Message}" FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap"
                                               Style="{StaticResource ErrorTextStyle}" Margin="0" />
                                    <TextBlock Text="{Binding Note}" FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="{Binding ActionLabel}" Command="{Binding FixCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                            Visibility="{Binding HasAction, Converter={StaticResource PageBoolToVisibility}}"
                                            AutomationProperties.Name="{Binding ActionLabel}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <ItemsControl ItemsSource="{Binding Media}" Focusable="False"
                          Visibility="{Binding ShowsDetectedMedia, Converter={StaticResource PageBoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DetectedMediaViewModel}">
                        <Border Padding="6" CornerRadius="4" ToolTip="{Binding ToolTip}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="&#xE792;" Style="{StaticResource RowIconButtonStyle}"
                                        Command="{Binding SaveAsCommand}" VerticalAlignment="Center" Margin="2,0,0,0"
                                        Visibility="{Binding CanDownload, Converter={StaticResource PageBoolToVisibility}}"
                                        ToolTip="Save as… (choose the folder and name)" AutomationProperties.Name="Save video as" />
                                <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Button Content="Download" Command="{Binding DownloadCommand}" MinWidth="88"
                                            Style="{DynamicResource AccentButtonStyle}"
                                            Visibility="{Binding CanDownload, Converter={StaticResource PageBoolToVisibility}}"
                                            AutomationProperties.Name="Download video" />
                                </Grid>

                                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFontFamily}" FontSize="20"
                                           VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE714;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Media.IsAudioOnly}" Value="True">
                                                    <Setter Property="Text" Value="&#xE8D6;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel VerticalAlignment="Center">
                                    <!-- The file name (it's saved under this name); quality and format are in the line below. -->
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Added to downloads" FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Visibility="{Binding WasQueued, Converter={StaticResource PageBoolToVisibility}}" />
                                    <!-- Streams with one quality (or a single-quality playlist): say what Download gets instead of a list. -->
                                    <TextBlock Text="{Binding QualitySummary}" FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Streams: choose the quality (best first); the size is an estimate from bitrate × length. -->
                                    <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Label"
                                              Margin="0,4,0,0" FontSize="{StaticResource CaptionFontSize}"
                                              Visibility="{Binding HasQualities, Converter={StaticResource PageBoolToVisibility}}"
                                              AutomationProperties.Name="Quality" />
                                    <!-- DASH with FFmpeg: choose the sound track ("automatic" = your language, codec that fits the picture). -->
                                    <ComboBox ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudio}" DisplayMemberPath="Label"
                                              Margin="0,4,0,0" FontSize="{StaticResource CaptionFontSize}"
                                              Visibility="{Binding HasAudioChoices, Converter={StaticResource PageBoolToVisibility}}"
                                              AutomationProperties.Name="Sound track" />
                                    <TextBlock Text="{Binding Message}" FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap"
                                               Style="{StaticResource ErrorTextStyle}" Margin="0" />
                                    <TextBlock Text="{Binding Note}" FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Pages not on yt-dlp's built-in list: ask yt-dlp anyway. -->
            <Button Content="Try yt-dlp on this page" Command="{Binding TryYtDlpCommand}" HorizontalAlignment="Left" Margin="6,8,0,2"
                    Visibility="{Binding CanTryYtDlp, Converter={StaticResource PageBoolToVisibility}}"
                    ToolTip="yt-dlp knows 1,000+ sites; it reads this page and lists what it finds."
                    AutomationProperties.Name="Try yt-dlp on this page" />
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</UserControl>

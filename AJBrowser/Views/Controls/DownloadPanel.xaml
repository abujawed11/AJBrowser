<UserControl x:Class="AJBrowser.Views.Controls.DownloadPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AJBrowser.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DownloadsViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="360">
    <!--
        Content of the toolbar's downloads flyout (DataContext: DownloadsViewModel): the newest few downloads with
        their progress and buttons. Click a finished download to open it. "Show all" opens ajbrowser://downloads.
    -->
    <StackPanel>
        <DockPanel Margin="4,0,0,8">
            <Button DockPanel.Dock="Right" Content="&#xE838;"
                    Style="{StaticResource RowIconButtonStyle}"
                    Command="{Binding OpenDownloadFolderCommand}" Click="ClosingButton_Click"
                    ToolTip="Open download folder" AutomationProperties.Name="Open download folder" />
            <TextBlock Text="Downloads" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Text="Files you download appear here." Margin="4,8,4,12"
                   Style="{StaticResource SecondaryTextStyle}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource PageBoolToVisibility}}" />

        <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="6,6"
                            ToolTip="{Binding ToolTip}"
                            MouseLeftButtonUp="Row_MouseLeftButtonUp">
                        <DockPanel>
                            <!-- Actions (only the ones that apply are shown). -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                <Button Content="&#xE769;" Style="{StaticResource RowIconButtonStyle}" Command="{Binding PauseCommand}"
                                        Visibility="{Binding CanPause, Converter={StaticResource PageBoolToVisibility}}"
                                        ToolTip="Pause" AutomationProperties.Name="Pause" />
                                <Button Content="&#xE768;" Style="{StaticResource RowIconButtonStyle}" Command="{Binding ResumeCommand}"
                                        Visibility="{Binding CanResume, Converter={StaticResource PageBoolToVisibility}}"
                                        ToolTip="Resume" AutomationProperties.Name="Resume" />
                                <Button Content="&#xE72C;" Style="{StaticResource RowIconButtonStyle}" Command="{Binding RetryCommand}"
                                        Click="ClosingButton_Click"
                                        Visibility="{Binding CanRetry, Converter={StaticResource PageBoolToVisibility}}"
                                        ToolTip="Retry (downloads it again in a new tab)" AutomationProperties.Name="Retry" />
                                <Button Content="&#xE711;" Style="{StaticResource RowIconButtonStyle}" Command="{Binding CancelCommand}"
                                        Visibility="{Binding CanCancel, Converter={StaticResource PageBoolToVisibility}}"
                                        ToolTip="Cancel" AutomationProperties.Name="Cancel download" />
                                <Button Content="&#xE838;" Style="{StaticResource RowIconButtonStyle}" Command="{Binding ShowInFolderCommand}"
                                        Click="ClosingButton_Click"
                                        Visibility="{Binding IsCompleted, Converter={StaticResource PageBoolToVisibility}}"
                                        ToolTip="Show in folder" AutomationProperties.Name="Show in folder" />
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" FontFamily="{StaticResource IconFontFamily}" FontSize="20"
                                       VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}" />

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanOpen}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ShowProgress}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ProgressBar Height="3" MinHeight="0" Margin="0,4,0,2" BorderThickness="0"
                                             Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Visibility="{Binding ShowProgress, Converter={StaticResource PageBoolToVisibility}}"
                                             AutomationProperties.Name="Download progress" />
                                <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource CaptionFontSize}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                                <Condition Binding="{Binding CanOpen}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ToolbarButtonHoverBrush}" />
                            <Setter TargetName="Row" Property="Cursor" Value="Hand" />
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Height="1" Margin="0,8" Background="{DynamicResource ChromeBorderBrush}" />
        <Button Content="Show all downloads" HorizontalAlignment="Left"
                Style="{StaticResource LinkButtonStyle}" Height="28"
                Command="{Binding ShowAllCommand}" Click="ClosingButton_Click"
                ToolTip="Ctrl+J" AutomationProperties.Name="Show all downloads" />
    </StackPanel>
</UserControl>

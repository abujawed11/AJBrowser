<UserControl x:Class="AJBrowser.Views.Controls.AddressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AJBrowser.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TabViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="600">
    <!-- DataContext: the TabViewModel. Focus and key handling live in the code-behind (view-only behaviour). -->
    <Grid>
        <TextBox x:Name="AddressBox"
                 Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center"
                 AutomationProperties.Name="Address and search bar"
                 PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown"
                 GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                 LostKeyboardFocus="AddressBox_LostKeyboardFocus"
                 PreviewKeyDown="AddressBox_PreviewKeyDown" />

        <!-- Placeholder, shown only while the box is empty. -->
        <TextBlock Text="Search or enter an address"
                   IsHitTestVisible="False"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=AddressBox}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>

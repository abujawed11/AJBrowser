<UserControl x:Class="AJBrowser.Views.Controls.AddressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AJBrowser.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TabViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="600">
    <!-- DataContext: the TabViewModel. Focus and key handling live in the code-behind (view-only behaviour). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="AddressBox"
                 Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center"
                 AutomationProperties.Name="Address and search bar"
                 PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown"
                 GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                 LostKeyboardFocus="AddressBox_LostKeyboardFocus"
                 PreviewKeyDown="AddressBox_PreviewKeyDown" />

        <!-- Placeholder, shown only while the box is empty. -->
        <TextBlock Text="Search or enter an address"
                   IsHitTestVisible="False"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=AddressBox}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Bookmark star (Ctrl+D): outline = not bookmarked, filled accent = bookmarked. -->
        <Button x:Name="StarButton" Grid.Column="1"
                Command="{Binding BookmarkPageCommand}"
                Margin="4,0,0,0"
                Visibility="{Binding CanBookmark, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Bookmark this page">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                    <Setter Property="Content" Value="&#xE734;" />
                    <Setter Property="ToolTip" Value="Bookmark this page (Ctrl+D)" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBookmarked}" Value="True">
                            <Setter Property="Content" Value="&#xE735;" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="ToolTip" Value="Edit bookmark (Ctrl+D)" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- ============ Suggestions drop-down (history + bookmarks) ============ -->
        <!-- StaysOpen: the view model decides when it closes. Nothing in it takes focus, so typing continues in the box. -->
        <Popup x:Name="SuggestionsPopup"
               Placement="Bottom"
               VerticalOffset="2"
               HorizontalOffset="-12"
               AllowsTransparency="True"
               StaysOpen="True"
               IsOpen="{Binding Suggestions.IsOpen, Mode=OneWay}">
            <Border Margin="12,0,12,12"
                    Width="{Binding ActualWidth, ElementName=AddressBox}"
                    Background="{DynamicResource FlyoutBackgroundBrush}"
                    BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.22" Direction="270" />
                </Border.Effect>
                <ListBox ItemsSource="{Binding Suggestions.Items}"
                         SelectedIndex="{Binding Suggestions.SelectedIndex, Mode=OneWay}"
                         Focusable="False"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Suggestions">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Suggestion_PreviewMouseLeftButtonDown" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="10,6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ToolbarButtonHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ToolbarButtonPressedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SuggestionItem}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}"
                                           FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding DisplayTitle, Mode=OneWay}" />
                                    <Run Text="  —  " Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Run Text="{Binding DisplayUrl, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>

        <!-- ============ Bookmark edit panel (opens from the star / Ctrl+D) ============ -->
        <Popup x:Name="BookmarkPopup"
               Placement="Bottom"
               HorizontalOffset="-290" VerticalOffset="-4"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsBookmarkEditorOpen, Mode=TwoWay}"
               Opened="BookmarkPopup_Opened"
               Closed="BookmarkPopup_Closed">
            <Border Margin="12" Width="320"
                    DataContext="{Binding BookmarkEditor}"
                    Background="{DynamicResource FlyoutBackgroundBrush}"
                    BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14"
                    TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                    PreviewKeyDown="BookmarkPopup_PreviewKeyDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.25" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Name" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="BookmarkNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Bookmark name" />
                    <TextBlock Text="Folder" Margin="0,10,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding Folders}"
                              SelectedItem="{Binding SelectedFolder}"
                              DisplayMemberPath="Name"
                              AutomationProperties.Name="Bookmark folder" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Remove" MinWidth="80" Margin="0,0,8,0"
                                Command="{Binding RemoveCommand}"
                                Click="BookmarkPopupClose_Click" />
                        <Button Content="Done" MinWidth="80" IsDefault="True"
                                Style="{DynamicResource AccentButtonStyle}"
                                Click="BookmarkPopupClose_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

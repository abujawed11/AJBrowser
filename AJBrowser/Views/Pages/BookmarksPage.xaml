<UserControl x:Class="AJBrowser.Views.Pages.BookmarksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AJBrowser.ViewModels.Pages"
             xmlns:controls="clr-namespace:AJBrowser.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BookmarksPageViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1000" d:DesignHeight="700"
             Background="{DynamicResource ContentBackgroundBrush}">
    <!-- DataContext: BookmarksPageViewModel (ajbrowser://bookmarks). List on the left, the selected item's details on the right. -->
    <Grid MaxWidth="1100" Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="Bookmarks" Style="{StaticResource PageTitleStyle}" />

        <!-- Toolbar: up, current folder, search, new folder -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Content="&#xE74A;" Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding GoUpCommand}" ToolTip="Up one folder" AutomationProperties.Name="Up one folder" />
            <Button DockPanel.Dock="Right" Content="New folder" Command="{Binding NewFolderCommand}" Margin="8,0,0,0" />
            <Grid DockPanel.Dock="Right" Width="220" Margin="8,0,0,0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" AutomationProperties.Name="Search bookmarks" />
                <TextBlock Text="Search bookmarks" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <TextBlock Text="{Binding FolderPath}" VerticalAlignment="Center" Margin="8,0,0,0"
                       FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- The list -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="4">
            <Grid>
                <TextBlock Text="{Binding EmptyText}" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Style="{StaticResource SecondaryTextStyle}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource PageBoolToVisibility}}" />
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                         ItemContainerStyle="{StaticResource PageRowStyle}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyDown="List_KeyDown"
                         AutomationProperties.Name="Bookmarks">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BookmarkItemViewModel}">
                            <DockPanel Background="Transparent"
                                       MouseLeftButtonDown="Row_MouseLeftButtonDown"
                                       MouseUp="Row_MouseUp">
                                <controls:SiteIcon DockPanel.Dock="Left" Source="{Binding Icon}" Glyph="{Binding Glyph}" Margin="4,0,12,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                               FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Details of the selected item -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <Grid>
                <TextBlock Text="Select a bookmark or folder to rename, move or delete it. Double-click to open.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource PageBoolToVisibility}}">
                    <TextBlock Text="Name" Margin="0,0,0,4" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name" />
                    <StackPanel Visibility="{Binding IsSelectedBookmark, Converter={StaticResource PageBoolToVisibility}}">
                        <TextBlock Text="Address" Margin="0,12,0,4" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBox Text="{Binding EditUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Address" />
                    </StackPanel>
                    <TextBlock Text="Folder" Margin="0,12,0,4" Style="{StaticResource SecondaryTextStyle}" />
                    <ComboBox ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding EditFolder}"
                              DisplayMemberPath="Name" AutomationProperties.Name="Folder" />
                    <TextBlock Text="{Binding EditError}" Style="{StaticResource ErrorTextStyle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" MinWidth="80" Margin="0,0,8,0" />
                        <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="80"
                                Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="AJBrowser.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AJBrowser.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsPageViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="900" d:DesignHeight="1200"
             Background="{DynamicResource ContentBackgroundBrush}">
    <!-- DataContext: SettingsPageViewModel (ajbrowser://settings). Changes apply immediately; there is no Save button. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="760" Margin="32,24,32,48">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <!-- ============ Appearance ============ -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,8" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Theme" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton GroupName="Theme" Content="Use Windows setting" IsChecked="{Binding IsThemeSystem}" Margin="0,0,24,0" />
                        <RadioButton GroupName="Theme" Content="Light" IsChecked="{Binding IsThemeLight}" Margin="0,0,24,0" />
                        <RadioButton GroupName="Theme" Content="Dark" IsChecked="{Binding IsThemeDark}" />
                    </StackPanel>
                    <Border Height="1" Margin="0,12" Background="{DynamicResource ChromeBorderBrush}" />
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggleStyle}"
                                      IsChecked="{Binding ShowBookmarksBar}" AutomationProperties.Name="Show bookmarks bar" />
                        <StackPanel>
                            <TextBlock Text="Show bookmarks bar" FontWeight="SemiBold" />
                            <TextBlock Text="Ctrl+Shift+B" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ============ On startup ============ -->
            <TextBlock Text="On startup" Style="{StaticResource SectionHeadingStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <RadioButton GroupName="Startup" Content="Open the home page" IsChecked="{Binding IsStartupHomePage}" />
                    <RadioButton GroupName="Startup" Content="Continue where you left off (reopen your tabs)" IsChecked="{Binding IsStartupRestore}" Margin="0,8,0,0" />
                    <Border Height="1" Margin="0,12" Background="{DynamicResource ChromeBorderBrush}" />
                    <TextBlock Text="Home page" FontWeight="SemiBold" />
                    <TextBlock Text="Also opens with the Home button and in new tabs." Style="{StaticResource SecondaryTextStyle}" />
                    <TextBox Margin="0,8,0,0" Text="{Binding HomePageText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Home page"
                             LostKeyboardFocus="HomePage_LostKeyboardFocus" KeyDown="HomePage_KeyDown" />
                    <TextBlock Text="{Binding HomePageError}" Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>
            </Border>

            <!-- ============ Search ============ -->
            <TextBlock Text="Search" Style="{StaticResource SectionHeadingStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" MinWidth="200"
                                  ItemsSource="{Binding SearchEngineOptions}" SelectedItem="{Binding SelectedSearchEngine}"
                                  DisplayMemberPath="Name" AutomationProperties.Name="Search engine" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Search engine used in the address bar" FontWeight="SemiBold" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCustomSearch, Converter={StaticResource PageBoolToVisibility}}">
                        <TextBlock Text="Search address: put {query} where the search words go." Style="{StaticResource SecondaryTextStyle}" />
                        <TextBox Margin="0,8,0,0" Text="{Binding CustomSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Custom search address"
                                 LostKeyboardFocus="CustomSearch_LostKeyboardFocus" KeyDown="CustomSearch_KeyDown" />
                        <TextBlock Text="{Binding CustomSearchError}" Style="{StaticResource ErrorTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Privacy ============ -->
            <TextBlock Text="Privacy" Style="{StaticResource SectionHeadingStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel DataContext="{Binding AdBlock}">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}"
                                      AutomationProperties.Name="Block ads" />
                        <StackPanel>
                            <TextBlock Text="Block ads and trackers" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Headline}" Style="{StaticResource SecondaryTextStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="-8,4,0,0">
                                <Button Content="Ad blocker settings" Style="{StaticResource LinkButtonStyle}" Height="28"
                                        Command="{Binding OpenSettingsCommand}" />
                                <TextBlock Text="{Binding Engine}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           FontSize="{StaticResource CaptionFontSize}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <Border Height="1" Margin="0,12" Background="{DynamicResource ChromeBorderBrush}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Clear browsing data…" Command="{Binding OpenHistoryCommand}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="History, cookies and cache" FontWeight="SemiBold" />
                            <TextBlock Text="Opens History, where you can clear data for a time range (Ctrl+Shift+Delete)." Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ============ Downloads ============ -->
            <TextBlock Text="Downloads" Style="{StaticResource SectionHeadingStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Reset" Command="{Binding ResetDownloadFolderCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding HasCustomDownloadFolder, Converter={StaticResource PageBoolToVisibility}}" />
                            <Button Content="Change…" Click="ChangeDownloadFolder_Click" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Save files to" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DownloadFolderText}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <Border Height="1" Margin="0,12" Background="{DynamicResource ChromeBorderBrush}" />
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggleStyle}"
                                      IsChecked="{Binding AskWhereToSave}" AutomationProperties.Name="Ask where to save each file" />
                        <TextBlock Text="Ask where to save each file" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Height="1" Margin="0,12" Background="{DynamicResource ChromeBorderBrush}" />
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"
                                      IsChecked="{Binding DetectVideos}" AutomationProperties.Name="Detect videos on pages" />
                        <StackPanel>
                            <TextBlock Text="Detect videos on pages" FontWeight="SemiBold" />
                            <TextBlock Text="Shows a film button in the toolbar when a page has a video you can download."
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Height="1" Margin="0,12" Background="{DynamicResource ChromeBorderBrush}" />
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"
                                      IsChecked="{Binding YtDlpEnabled}" AutomationProperties.Name="Big video sites (yt-dlp)" />
                        <StackPanel>
                            <TextBlock Text="Big video sites (yt-dlp)" FontWeight="SemiBold" />
                            <TextBlock Text="Download from YouTube, Facebook, Instagram, TikTok, X, Vimeo and 1,000+ other sites with the free yt-dlp tool."
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <!-- The one-time notice when switching it on. -->
                    <Border Margin="0,10,0,0" Padding="12" CornerRadius="6" Background="{DynamicResource TabHoverBackgroundBrush}"
                            Visibility="{Binding ShowYtDlpNotice, Converter={StaticResource PageBoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Before you turn this on" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}"
                                       Text="Only download videos you have the right to keep, such as your own, public-domain or freely licensed ones. Some sites' terms of service forbid downloading. Protected (DRM) videos can't be downloaded. yt-dlp is a separate open-source program (public domain) that AJBrowser installs from its official release when you click Install below." />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="I understand, turn it on" Command="{Binding AcceptYtDlpNoticeCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="Cancel" Command="{Binding DeclineYtDlpNoticeCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,10,0,0" Visibility="{Binding YtDlpEnabled, Converter={StaticResource PageBoolToVisibility}}">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoUpdateYtDlp}" AutomationProperties.Name="Update yt-dlp automatically" />
                        <StackPanel>
                            <TextBlock Text="Update yt-dlp automatically" FontWeight="SemiBold" />
                            <TextBlock Text="Checked once a day. Sites like YouTube change often, and an old yt-dlp stops working with them."
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Height="1" Margin="0,12" Background="{DynamicResource ChromeBorderBrush}" />
                    <TextBlock Text="Video tools" FontWeight="SemiBold" />
                    <TextBlock Text="Free programs AJBrowser uses for some videos. Install downloads the official release, checks it and keeps it in AJBrowser's data folder; Choose… uses your own copy instead."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding ToolRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ToolRowViewModel}">
                                <DockPanel Margin="0,8,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" Margin="0,0,8,0" MinWidth="76"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Install or update {0}'}" />
                                        <Button Content="Clear" Command="{Binding ClearPathCommand}" Margin="0,0,8,0"
                                                Visibility="{Binding HasCustomPath, Converter={StaticResource PageBoolToVisibility}}"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Stop using your own {0}'}" />
                                        <Button Content="Choose…" Click="ChooseTool_Click" Tag="{Binding}"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Choose your own {0}'}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Licence, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Progress}" FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Margin="0,12" Background="{DynamicResource ChromeBorderBrush}" />
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="80"
                                  ItemsSource="{Binding ConcurrentDownloadChoices}"
                                  SelectedItem="{Binding MaxConcurrentDownloads}"
                                  AutomationProperties.Name="Simultaneous video downloads" />
                        <StackPanel>
                            <TextBlock Text="Simultaneous video downloads" FontWeight="SemiBold" />
                            <TextBlock Text="Videos and streams downloaded from the film button beyond this number wait their turn. Normal downloads aren't limited."
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ============ About ============ -->
            <TextBlock Text="About" Style="{StaticResource SectionHeadingStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                    <TextBlock Text="Built on Microsoft Edge WebView2. Ad blocking by uBlock Origin Lite (GPLv3)." Style="{StaticResource SecondaryTextStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="-8,8,0,0">
                        <Button Content="Third-party notices" Style="{StaticResource LinkButtonStyle}" Height="28" Command="{Binding OpenNoticesCommand}" />
                        <Button Content="Open data folder" Style="{StaticResource LinkButtonStyle}" Height="28" Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

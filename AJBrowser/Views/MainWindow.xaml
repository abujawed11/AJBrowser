<Window x:Class="AJBrowser.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AJBrowser.ViewModels"
        xmlns:svc="clr-namespace:AJBrowser.Services"
        xmlns:controls="clr-namespace:AJBrowser.Views.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding SelectedTab.WindowTitle, FallbackValue=AJBrowser, TargetNullValue=AJBrowser}"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource BodyFontSize}"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Tab strip ============ -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppBackgroundBrush}"
                Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVisibility}}">
            <controls:TabStrip />
        </Border>

        <!-- ============ Toolbar ============ -->
        <Border Grid.Row="1"
                Height="{StaticResource ChromeBarHeight}"
                Background="{DynamicResource ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <DockPanel Margin="6,0" LastChildFill="True">
                    <!-- Navigation buttons (bound to the selected tab). -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                                DataContext="{Binding SelectedTab}">
                        <Button Content="&#xE72B;" Command="{Binding GoBackCommand}"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back" />
                        <Button Content="&#xE72A;" Command="{Binding GoForwardCommand}"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward" />
                        <Button Command="{Binding ReloadOrStopCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                                    <Setter Property="Content" Value="&#xE72C;" />
                                    <Setter Property="ToolTip" Value="Reload (F5)" />
                                    <Setter Property="AutomationProperties.Name" Value="Reload" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Content" Value="&#xE711;" />
                                            <Setter Property="ToolTip" Value="Stop loading (Esc)" />
                                            <Setter Property="AutomationProperties.Name" Value="Stop loading" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="&#xE80F;" Command="{Binding HomeCommand}"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="Home (Alt+Home)" AutomationProperties.Name="Home" />
                    </StackPanel>

                    <!-- App menu (theme, zoom, print, data folder, debug tools). A ContextMenu is a popup, so it can open over the page. -->
                    <Button x:Name="MenuButton" DockPanel.Dock="Right"
                            Content="&#xE712;"
                            Click="OpenButtonMenu_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            VerticalAlignment="Center"
                            ToolTip="Settings and more" AutomationProperties.Name="Settings and more">
                        <Button.ContextMenu>
                            <!-- Reset the font: otherwise the menu inherits the button's icon font and letters show as squares. -->
                            <ContextMenu FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource BodyFontSize}">
                                <MenuItem Header="New tab" InputGestureText="Ctrl+T" Command="{Binding NewTabCommand}" />
                                <MenuItem Header="Reopen closed tab" InputGestureText="Ctrl+Shift+T" Command="{Binding ReopenClosedTabCommand}" />
                                <Separator />
                                <MenuItem Header="Zoom in" InputGestureText="Ctrl+Plus" Command="{Binding SelectedTab.ZoomInCommand}" />
                                <MenuItem Header="Zoom out" InputGestureText="Ctrl+Minus" Command="{Binding SelectedTab.ZoomOutCommand}" />
                                <MenuItem Header="Reset zoom" InputGestureText="Ctrl+0" Command="{Binding SelectedTab.ResetZoomCommand}" />
                                <MenuItem Header="Find on page" InputGestureText="Ctrl+F" Click="FindMenuItem_Click" />
                                <MenuItem Header="Print" InputGestureText="Ctrl+P" Command="{Binding SelectedTab.PrintCommand}" />
                                <MenuItem Header="Full screen" InputGestureText="F11" Command="{Binding ToggleFullScreenCommand}" />
                                <Separator />
                                <MenuItem Header="Theme">
                                    <MenuItem Header="System" IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                                              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.System}" />
                                    <MenuItem Header="Light" IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Light}" />
                                    <MenuItem Header="Dark" IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Dark}" />
                                </MenuItem>
                                <MenuItem Header="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                                <Separator Visibility="{Binding IsDebugBuild, Converter={StaticResource BoolToVisibility}}" />
                                <MenuItem Header="Diagnostics (debug)" Click="OpenDiagnostics_Click"
                                          Visibility="{Binding IsDebugBuild, Converter={StaticResource BoolToVisibility}}" />
                                <MenuItem Header="Throw test exception (debug)" Command="{Binding ThrowTestExceptionCommand}"
                                          Visibility="{Binding IsDebugBuild, Converter={StaticResource BoolToVisibility}}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!--
                        Ad blocker shield (Phase 2.5). Green filled shield with a tick = blocking; grey shield with a slash = off
                        (or unavailable). Click it for the panel with the on/off switch.
                    -->
                    <Button x:Name="AdBlockButton" DockPanel.Dock="Right"
                            Click="AdBlockButton_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            VerticalAlignment="Center"
                            ToolTip="{Binding AdBlockToolTip}"
                            AutomationProperties.Name="{Binding AdBlockToolTip}">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="16" Height="16">
                                <Path x:Name="ShieldShape"
                                      Data="M8,1 L14,3.4 V7.8 C14,11.3 11.4,14.1 8,15 C4.6,14.1 2,11.3 2,7.8 V3.4 Z"
                                      StrokeThickness="1.3" StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdBlockEnabled}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <!-- Tick (on) -->
                                <Path Data="M5.2,8.1 L7.2,10.1 L10.9,6.3"
                                      Stroke="{DynamicResource ChromeBackgroundBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="{Binding IsAdBlockEnabled, Converter={StaticResource BoolToVisibility}}" />
                                <!-- Slash (off) -->
                                <Path Data="M2.5,2.5 L13.5,14"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdBlockEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- The shield's panel. A Popup is its own window, so (like menus) it can open over the page. -->
                    <Popup x:Name="AdBlockPopup"
                           PlacementTarget="{Binding ElementName=AdBlockButton}"
                           Placement="Bottom"
                           HorizontalOffset="-286" VerticalOffset="-4"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           Closed="AdBlockPopup_Closed">
                        <!-- The outer margin leaves room for the shadow. -->
                        <Border Margin="12" Width="320"
                                Background="{DynamicResource FlyoutBackgroundBrush}"
                                BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16,14"
                                TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                PreviewKeyDown="AdBlockPopup_PreviewKeyDown">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.25" Direction="270" />
                            </Border.Effect>
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <ToggleButton x:Name="AdBlockSwitch" DockPanel.Dock="Right"
                                                  Style="{StaticResource SwitchToggleStyle}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsAdBlockEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsAdBlockAvailable}"
                                                  AutomationProperties.Name="Block ads" />
                                    <TextBlock Text="Block ads" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding AdBlockHeadline}" Margin="0,10,0,0" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AdBlockDetail}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Border Height="1" Margin="0,12" Background="{DynamicResource ChromeBorderBrush}" />
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Command="{Binding OpenAdBlockSettingsCommand}"
                                            Click="AdBlockSettings_Click"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource BodyFontSize}"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Width="Auto" Padding="8,0" Margin="0"
                                            Content="Settings"
                                            ToolTip="Filtering mode and per-site exceptions (opens in a new tab)"
                                            AutomationProperties.Name="Ad blocker settings" />
                                    <TextBlock Text="{Binding AdBlockEngine}" VerticalAlignment="Center"
                                               FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Indicators for the selected tab: blocked pop-ups and zoom level (only shown when relevant). -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                DataContext="{Binding SelectedTab}">
                        <Button Content="&#xE8A7;"
                                Click="OpenButtonMenu_Click"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Foreground="{DynamicResource AccentBrush}"
                                Visibility="{Binding HasBlockedPopups, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Pop-ups were blocked on this page"
                                AutomationProperties.Name="Blocked pop-ups">
                            <Button.ContextMenu>
                                <ContextMenu FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource BodyFontSize}"
                                             ItemsSource="{Binding BlockedPopups}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding StringFormat='Open {0}', TargetNullValue='(page did not give an address)'}" />
                                            <Setter Property="Command" Value="{Binding DataContext.OpenBlockedPopupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="{Binding ZoomText}"
                                Command="{Binding ResetZoomCommand}"
                                Style="{StaticResource ToolbarButtonStyle}"
                                FontFamily="{StaticResource UiFontFamily}"
                                FontSize="{StaticResource CaptionFontSize}"
                                Width="Auto" Padding="8,0" MinWidth="48"
                                Visibility="{Binding IsZoomed, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Reset zoom (Ctrl+0)"
                                AutomationProperties.Name="Reset zoom" />
                    </StackPanel>

                    <controls:AddressBar x:Name="AddressBar"
                                         DataContext="{Binding SelectedTab}"
                                         Margin="6,0"
                                         Height="34"
                                         VerticalAlignment="Center" />
                </DockPanel>

                <!-- Thin loading indicator along the bottom edge of the toolbar. -->
                <ProgressBar DataContext="{Binding SelectedTab}"
                             IsIndeterminate="{Binding IsLoading}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                             VerticalAlignment="Bottom"
                             Height="2" MinHeight="0"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource AccentBrush}"
                             AutomationProperties.Name="Page loading" />
            </Grid>
        </Border>

        <!-- ============ Find bar (selected tab) ============ -->
        <controls:FindBar x:Name="FindBar" Grid.Row="2"
                          DataContext="{Binding SelectedTab}"
                          Visibility="{Binding IsFindBarOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

        <!-- ============ Page area ============ -->
        <Grid Grid.Row="3" Background="{DynamicResource ContentBackgroundBrush}">
            <!--
                One WebView host per tab, stacked in the same cell; only the selected tab's is visible.
                Hidden tabs keep their page state (scroll position, video, forms).
            -->
            <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TabViewModel}">
                        <ContentPresenter Content="{Binding BrowserView}"
                                          Visibility="{Binding IsPageShown, Converter={StaticResource BoolToVisibility}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Problem panel for the selected tab: network errors, crashes, engine failures. -->
            <ScrollViewer DataContext="{Binding SelectedTab}"
                          Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="24">
                    <TextBlock Text="&#xE783;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="40"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Problem.Title}"
                               Margin="0,16,0,0"
                               FontSize="{StaticResource HeadingFontSize}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Problem.Message}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Problem.Detail}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource CaptionFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Content="{Binding Problem.ActionText}"
                            Command="{Binding RetryCommand}"
                            HorizontalAlignment="Left"
                            MinWidth="120"
                            Margin="0,20,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

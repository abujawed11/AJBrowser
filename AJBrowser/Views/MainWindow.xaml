<Window x:Class="AJBrowser.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AJBrowser.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="AJBrowser"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource BodyFontSize}"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Chrome bar: becomes the tab strip + toolbar in Phases 1-2. -->
        <Border Grid.Row="0"
                Height="{StaticResource ChromeBarHeight}"
                Background="{DynamicResource ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE774;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="{StaticResource IconSize}"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="AJBrowser" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Diagnostics"
                            Click="OpenDiagnostics_Click"
                            Visibility="{Binding IsDebugBuild, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="DEBUG only: Phase 0.5 WebView2 feasibility spike"
                            Margin="0,0,8,0" />
                    <Button Content="Throw test exception"
                            Command="{Binding ThrowTestExceptionCommand}"
                            Visibility="{Binding IsDebugBuild, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="DEBUG only: checks the global error handler"
                            Margin="0,0,12,0" />
                    <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme}"
                              MinWidth="110"
                              AutomationProperties.Name="Theme" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content area: will host the WebView2 tabs from Phase 1. -->
        <Border Grid.Row="1" Background="{DynamicResource ContentBackgroundBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <TextBlock Text="AJBrowser"
                           FontSize="{StaticResource TitleFontSize}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="The foundation is ready. Browsing arrives in Phase 1."
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Margin="0,24,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="App data folder:" />
                    <Run Text="{Binding DataFolder, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" />
                </TextBlock>
                <Button Content="Open data folder"
                        Command="{Binding OpenDataFolderCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-free logic: no WPF or WebView2 references allowed here, so everything stays unit-testable. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Needed only by Blocking/NativeMethods.cs (pointers into the adblock-rust DLL). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brave's adblock-rust engine behind a small C wrapper (Phase 8; source and build in native/adblock-shim).
         Copied next to every program that uses Core (the app and the tests). -->
    <None Include="Native\adblock_shim.dll" Link="adblock_shim.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AJBrowser.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

</Project>
